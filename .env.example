# Codebase Intelligence & Developer Copilot - example environment.
# Copy to .env and fill in what you need. Everything works with no keys:
# hashing embeddings + heuristic reranker + extractive answers are the fallbacks.

# --- Storage ---
# Where indexes, SQLite DB and cloned repos live.
DATA_DIR=./data
# Where remote repos get cloned.
REPO_WORKDIR=./data/repos

# --- Embeddings ---
# auto | openai | sentence-transformers | hashing
EMBEDDING_BACKEND=auto
# Only used by the hashing fallback embedder.
EMBEDDING_DIM=512
# sentence-transformers model (used when backend resolves to it)
ST_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
# numpy (local, zero-dependency) | qdrant (requires qdrant-client; local path mode)
VECTOR_BACKEND=numpy

# --- OpenAI-compatible LLM (optional) ---
# If OPENAI_API_KEY is set, answers are generated by the LLM with enforced citations.
# Otherwise a deterministic extractive answerer is used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Reranker ---
# heuristic | cross-encoder | auto
RERANKER=heuristic
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval tuning ---
TOP_K=5
VECTOR_TOP_N=20
BM25_TOP_M=20
WEIGHT_VECTOR=0.5
WEIGHT_BM25=0.5
RECENCY_BOOST=0.05

# --- GitHub (optional) ---
# Needed only to enrich ingestion with PRs/issues via the GitHub REST API.
GITHUB_TOKEN=

# --- Misc ---
LOG_LEVEL=INFO
